PORT=4000
DATABASE_URL=postgres://postgres:corvus@localhost:5433/corvus
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Prompt-injection gate for web search results (see tools/webSearch.js) —
# kept separate from GEMINI_MODEL so the guard call can run on its own model.
GEMINI_GUARD_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=low
# web_search tool (tools/webSearch.js) — https://tavily.com
TAVILY_API_KEY=your-tavily-api-key
REDIS_URL=redis://localhost:4203
# Proactive messaging: a judge model vets each thought and the main model
# decides whether to message the user. Cooldown caps judge-approved
# surfacing (and thus proactive messages) to at most one per interval.
PROACTIVE_ENABLED=true
PROACTIVE_COOLDOWN_MS=300000
LOG_LEVEL=info
# Langfuse tracing (see src/tracing.js): every LLM call, tool call, thought,
# and reminder delivery is instrumented manually via @langfuse/tracing +
# @langfuse/otel. Tracing is entirely disabled when either key is unset —
# the app runs fine without Langfuse.
#
# Setup against a self-hosted Langfuse instance (e.g. one already running
# via docker compose on this machine — see its docker-compose.yml/.env):
#   1. Open the Langfuse UI (LANGFUSE_BASE_URL below) and sign in.
#   2. Create a new Project (e.g. "Corvus") inside your organization.
#   3. Project Settings -> API Keys -> Create new API key.
#   4. Copy the public/secret key pair below.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Memory subjects (see src/db.js): long-term memories can be tagged with
# who/what they're about (e.g. "bree", "Quentin", or nothing for a general
# fact). PRIMARY_SUBJECT is who the web frontend's chat is always attributed
# to, and the fallback for any inbound channel that can't resolve its own
# sender. Defaults to "bree" if unset.
PRIMARY_SUBJECT=bree

# Discord channel (see src/discord.js). Corvus only ever DMs, and accepts
# inbound chat messages from, DISCORD_ALLOWED_USER_ID — there is no way for
# it to message (or be messaged by) anyone else. Disabled entirely unless
# both of these are set. No public URL/webhook/ngrok needed: the bot opens
# its own outbound connection to Discord. Its Discord user id is
# automatically mapped to PRIMARY_SUBJECT in the subjects table on boot, so
# inbound DMs are attributed to that memory subject.
#   1. https://discord.com/developers/applications -> New Application ->
#      Bot tab -> Reset Token -> copy it into DISCORD_BOT_TOKEN below.
#   2. On the same Bot tab, enable the "Message Content Intent" toggle
#      under Privileged Gateway Intents (required to read DM text).
#   3. OAuth2 tab -> URL Generator -> scope "bot", permissions "Send
#      Messages" + "Read Message History" -> open the generated URL and
#      invite the bot to a server you're in (a private server just for you
#      works fine — the bot needs to share one server with you before you
#      can DM it).
#   4. In Discord, enable Settings -> Advanced -> Developer Mode, then
#      right-click your own username -> Copy User ID -> set as
#      DISCORD_ALLOWED_USER_ID below.
#   5. DM the bot (right-click it in the server member list -> Message) to
#      start talking to Corvus.
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_ALLOWED_USER_ID=your-discord-user-id
